{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express backend for Prehistoric Fauna Encyclopedia",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "safeguard:snapshot": "tsx scripts/verify-no-regression.ts --snapshot",
    "safeguard:verify": "tsx scripts/verify-no-regression.ts --verify",
    "safeguard:check": "tsx scripts/verify-no-regression.ts --snapshot && tsx scripts/verify-no-regression.ts --verify",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "npm run prisma:seed",
    "add-species": "tsx scripts/add-species.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "prisma": "^5.12.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
